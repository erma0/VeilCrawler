{
  "manifest_version": 3,
  "name": "VeilCrawler",
  "version": "1.0.0",
  "description": "轻量可视化通用web数据采集插件",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Open VeilCrawler"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "requestFramePermissions": []
}